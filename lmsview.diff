< const getDeadlineStatus = (startTime: string | null | undefined, endTime: string | null | undefined, contentType: string) => {
<   if (!startTime && !endTime) return null;
<   const now = new Date();
<   const typeLabel = contentType === "quiz" ? "Quiz" : "Tugas";
<   
<   const formatDate = (isoString: string) => {
<     try {
<       return new Date(isoString).toLocaleString('id-ID', {
<         weekday: 'long',
<         day: 'numeric',
<         month: 'short',
<         year: 'numeric',
<         hour: '2-digit',
<         minute: '2-digit'
<       });
<     } catch(e) {
<       return isoString;
<     }
<   };
< 
<   if (startTime) {
<     const start = new Date(startTime);
<     if (now < start) {
<       const diffMs = start.getTime() - now.getTime();
<       const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
<       const diffHours = Math.floor((diffMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
<       let timeStr = "";
<       if (diffDays > 0) timeStr += `${diffDays} hari `;
<       timeStr += `${diffHours} jam`;
<       return {
<         status: "upcoming",
<         label: `Belum Dimulai`,
<         text: `Dibuka pada ${formatDate(startTime)} (Mulai ${timeStr} lagi)`,
<         colorClass: "bg-amber-50 text-amber-700 border-amber-200 text-amber-600",
<         icon: "🕒"
<       };
<     }
<   }
< 
<   if (endTime) {
<     const end = new Date(endTime);
<     if (now > end) {
<       return {
<         status: "ended",
<         label: `${typeLabel} Selesai / Ditutup`,
<         text: `Batas waktu pengumpulan telah berakhir pada ${formatDate(endTime)}`,
<         colorClass: "bg-rose-50 text-rose-700 border-rose-200 text-rose-600",
<         icon: "❌"
<       };
<     } else {
<       const diffMs = end.getTime() - now.getTime();
<       const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
<       const diffHours = Math.floor((diffMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
<       const diffMins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
<       let sisaWaktu = "";
<       if (diffDays > 0) {
<         sisaWaktu = `${diffDays} hari ${diffHours} jam`;
<       } else if (diffHours > 0) {
<         sisaWaktu = `${diffHours} jam ${diffMins} menit`;
<       } else {
<         sisaWaktu = `${diffMins} menit`;
<       }
<       return {
<         status: "active",
<         label: `${typeLabel} Aktif`,
<         text: `Tenggang Waktu: ${formatDate(endTime)} (Sisa waktu pengerjaan: ${sisaWaktu})`,
<         colorClass: "bg-emerald-50 text-emerald-800 border-emerald-200 text-emerald-700",
<         icon: "⏳"
<       };
<     }
<   }
< 
<   if (startTime) {
<     return {
<       status: "active",
<       label: `${typeLabel} Berlangsung`,
<       text: `Mulai sejak ${formatDate(startTime)}`,
<       colorClass: "bg-blue-50 text-blue-700 border-blue-200 text-blue-600",
<       icon: "📢"
<     };
<   }
< 
<   return null;
< };
