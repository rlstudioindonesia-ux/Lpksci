rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access to all users (public profile pictures and documents)
      allow read: if true;
      
      // Allow write/upload for profile pictures, registrations, and documents
      allow write: if request.auth != null || request.resource.size < 10 * 1024 * 1024;
    }
  }
}
