rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "ivetuniversity@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Admin Super', 'Admin Biasa']
      ); 
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validations
    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'phone']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.phone is string && data.phone.size() <= 30;
    }

    // Registered Students
    match /registeredStudents/{id} {
      allow read: if isAdmin() || (isSignedIn() && (id == request.auth.uid || existing().email == request.auth.token.email));
      allow create: if isSignedIn() && isValidStudent(incoming()) && isValidId(id);
      allow update: if isAdmin() || (isSignedIn() && id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'education', 'birthDate']));
      allow delete: if isAdmin();
    }

    // Active Students
    match /activeStudents/{id} {
      allow read: if isAdmin() || (isSignedIn() && id == request.auth.uid);
      allow write: if isAdmin();
    }

    // Attendance
    match /attendance/{id} {
      allow read: if isAdmin() || (isSignedIn() && existing().studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Payments
    match /payments/{id} {
      allow read: if isAdmin() || (isSignedIn() && existing().studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // LMS Lessons
    match /lmsLessons/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users
    match /users/{id} {
      allow read: if isAdmin() || (isSignedIn() && id == request.auth.uid);
      allow create: if isSignedIn() && id == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email']));
      allow delete: if isAdmin();
    }

    // Customization & System
    match /system/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customization/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Events
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // LMS Comments
    match /lmsComments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Logs
    match /logs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // LMS Classes & Quizzes
    match /lmsClasses/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /lmsQuizzes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Catch-all for other collections defined in adapter but not specifically handled
    match /inventory/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /taxes/{id} { allow read, write: if isAdmin(); }
    match /chapterAssessments/{id} { 
      allow read: if isAdmin() || (isSignedIn() && existing().studentId == request.auth.uid); 
      allow write: if isAdmin(); 
    }
    match /jobOrders/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /salaries/{id} { allow read, write: if isAdmin(); }
    match /cashLedger/{id} { allow read, write: if isAdmin(); }
    match /messages/{id} { allow read: if isAdmin() || (isSignedIn() && (existing().fromId == request.auth.uid || existing().toId == request.auth.uid)); allow create: if isSignedIn(); }
    
    match /test/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
